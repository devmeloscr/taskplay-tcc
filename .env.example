# Copie para .env (que nao e versionado) e ajuste se necessario.

# Banco de dados (porta 5433: ver docker-compose.yml)
DATABASE_URL="postgresql://taskplay:taskplay@localhost:5433/taskplay?schema=public"

# API
PORT=3000

# Observabilidade (OpenTelemetry -> SigNoz)
OTEL_SERVICE_NAME=taskplay-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# Desliga o envio de telemetria sem precisar remover codigo (util quando a
# stack do SigNoz nao esta no ar).
OTEL_SDK_DISABLED=false

TELEMETRY_PSEUDONYM_SALT=troque-este-valor-em-campo

AUTH_JWT_SECRET=troque-este-valor-em-campo-com-32-caracteres-ou-mais
# Validade do access token, em segundos. Curto de proposito: e o que faz uma
# revogacao valer rapido sem obrigar o aplicativo a renovar a cada tela.
AUTH_ACCESS_TOKEN_TTL=900
# Validade do refresh token, em dias. O teste de campo dura 30, e uma familia
# que passe um fim de semana sem abrir o aplicativo nao pode voltar ao login.
AUTH_REFRESH_TOKEN_TTL_DAYS=60

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=taskplay
STORAGE_SECRET_KEY=taskplay-storage
STORAGE_BUCKET=taskplay-evidencias
STORAGE_RETENTION_AFTER_REVIEW_DAYS=7
# Teto absoluto contado do envio, que apanha a evidencia que ninguem revisou.
STORAGE_RETENTION_MAX_DAYS=30
