# Expo/React Native exigem node_modules "achatado": o Metro (bundler do RN) não
# percorre os symlinks que o pnpm cria por padrão. Recomendação oficial do Expo
# para monorepos com pnpm.
node-linker=hoisted

# Evita que peer deps divergentes do ecossistema React Native travem a instalação.
strict-peer-dependencies=false
