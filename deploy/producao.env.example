TASKPLAY_DOMINIO=seu-dominio.exemplo
# Recebe o aviso de expiracao do certificado. Nao aparece em lugar nenhum
# publico.
TASKPLAY_EMAIL_ACME=troque-este-valor

POSTGRES_USER=taskplay
POSTGRES_DB=taskplay
POSTGRES_PASSWORD=troque-este-valor

TRUST_PROXY_HOPS=1

LOG_LEVEL=info

AUTH_JWT_SECRET=troque-este-valor
AUTH_ACCESS_TOKEN_TTL=900
# 60 dias cobrem os 30 do teste de campo com folga: uma familia que passe um
# fim de semana sem abrir o aplicativo nao pode ser jogada de volta ao login.
AUTH_REFRESH_TOKEN_TTL_DAYS=60

STORAGE_ACCESS_KEY=taskplay
STORAGE_SECRET_KEY=troque-este-valor
STORAGE_BUCKET=taskplay-evidencias
STORAGE_RETENTION_AFTER_REVIEW_DAYS=7
STORAGE_RETENTION_MAX_DAYS=30

OTEL_SDK_DISABLED=false
TELEMETRY_PSEUDONYM_SALT=troque-este-valor

# Cadencia da varredura de tarefas vencidas. Omitido, roda de 30 em 30 minutos.
# TASKS_EXPIRY_CRON=0 */30 * * * *
