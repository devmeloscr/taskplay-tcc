{
  "name": "@taskplay/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "TS_NODE_PROJECT=apps/api/tsconfig.seed.json node --env-file=.env -r ts-node/register/transpile-only -r tsconfig-paths/register apps/api/src/seed.ts",
    "obs:up": "docker compose -f observability/pours/deployment/compose.yaml up -d",
    "obs:down": "docker compose -f observability/pours/deployment/compose.yaml down",
    "prod:obs:up": "docker compose --project-directory observability/pours/deployment -f observability/pours/deployment/compose.yaml -f deploy/compose.observability.yaml up -d",
    "prod:obs:down": "docker compose --project-directory observability/pours/deployment -f observability/pours/deployment/compose.yaml -f deploy/compose.observability.yaml down",
    "prod:up": "docker compose -f deploy/compose.yaml up -d --build",
    "prod:down": "docker compose -f deploy/compose.yaml down",
    "prod:logs": "docker compose -f deploy/compose.yaml logs -f api caddy",
    "prod:ps": "docker compose -f deploy/compose.yaml ps",
    "icones": "node tools/scripts/gerar-icones.mjs",
    "apk": "node tools/scripts/gerar-apk.mjs"
  },
  "private": true,
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
